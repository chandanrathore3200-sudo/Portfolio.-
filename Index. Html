<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Chandan | Premium Website</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0b0b0f;
      color: white;
      line-height: 1.6;
    }

    header {
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #111116;
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid #25252d;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
    }

    .logo span {
      color: #00e5ff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 18px;
      font-size: 14px;
    }

    nav a:hover {
      color: #00e5ff;
    }

    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      padding: 60px 7%;
      background:
        radial-gradient(circle at top right, #003d49, transparent 35%),
        #0b0b0f;
    }

    .hero-content {
      max-width: 650px;
    }

    .hero h1 {
      font-size: clamp(42px, 10vw, 75px);
      line-height: 1.05;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #00e5ff;
    }

    .hero p {
      color: #bdbdc7;
      font-size: 18px;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      padding: 13px 25px;
      border-radius: 30px;
      background: #00e5ff;
      color: #001014;
      text-decoration: none;
      font-weight: bold;
      margin-right: 10px;
    }

    .btn.dark {
      background: transparent;
      color: white;
      border: 1px solid #555;
    }

    section {
      padding: 70px 7%;
    }

    .title {
      text-align: center;
      font-size: 35px;
      margin-bottom: 40px;
    }

    .title span {
      color: #00e5ff;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: #15151c;
      border: 1px solid #292932;
      border-radius: 18px;
      padding: 30px;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-8px);
      border-color: #00e5ff;
    }

    .card h3 {
      color: #00e5ff;
      margin-bottom: 12px;
    }

    .card p {
      color: #aaa;
    }

    .about {
      background: #111116;
      text-align: center;
    }

    .about p {
      max-width: 750px;
      margin: auto;
      color: #bbb;
      font-size: 17px;
    }

    .contact {
      text-align: center;
    }

    .contact-box {
      max-width: 600px;
      margin: auto;
      background: #15151c;
      padding: 35px;
      border-radius: 20px;
    }

    .contact-box input,
    .contact-box textarea {
      width: 100%;
      padding: 14px;
      margin-bottom: 15px;
      background: #0b0b0f;
      color: white;
      border: 1px solid #333;
      border-radius: 10px;
      outline: none;
    }

    .contact-box textarea {
      height: 120px;
      resize: none;
    }

    footer {
      text-align: center;
      padding: 25px;
      background: #08080b;
      color: #888;
      border-top: 1px solid #222;
    }

    @media (max-width: 700px) {
      header {
        padding: 15px 5%;
      }

      nav a {
        margin-left: 8px;
        font-size: 12px;
      }

      .hero {
        min-height: 75vh;
        padding: 50px 6%;
      }

      .hero h1 {
        font-size: 48px;
      }

      .hero p {
        font-size: 16px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 6%;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">Chan<span>dan</span></div>

    <nav>
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>


  <section class="hero" id="home">
    <div class="hero-content">

      <h1>
        Build Your<br>
        <span>Digital Future.</span>
      </h1>

      <p>
        Welcome to my premium website. 
        यहाँ आपको modern design, creative ideas और digital services मिलेंगी।
      </p>

      <a href="#services" class="btn">My Services</a>
      <a href="#contact" class="btn dark">Contact Me</a>

    </div>
  </section>


  <section class="about" id="about">

    <h2 class="title">About <span>Me</span></h2>

    <p>
      मैं Chandan हूँ और मुझे Web Development, Designing और
      Digital Technology में रुचि है। यह वेबसाइट HTML, CSS और
      JavaScript का उपयोग करके बनाई गई है।
    </p>

  </section>


  <section id="services">

    <h2 class="title">My <span>Services</span></h2>

    <div class="cards">

      <div class="card">
        <h3>🌐 Web Design</h3>
        <p>
          Modern और mobile-friendly websites बनाना।
        </p>
      </div>

      <div class="card">
        <h3>🎨 Graphic Design</h3>
        <p>
          Posters, thumbnails, banners और social media designs।
        </p>
      </div>

      <div class="card">
        <h3>💻 Web Development</h3>
        <p>
          HTML, CSS और JavaScript से responsive websites बनाना।
        </p>
      </div>

    </div>

  </section>


  <section class="contact" id="contact">

    <h2 class="title">Contact <span>Me</span></h2>

    <div class="contact-box">

      <input type="text" placeholder="आपका नाम">

      <input type="email" placeholder="आपका Email">

      <textarea placeholder="अपना Message लिखें"></textarea>

      <button class="btn" onclick="sendMessage()">
        Send Message
      </button>

    </div>

  </section>


  <footer>
    © 2026 Chandan | All Rights Reserved
  </footer>


  <script>

    function sendMessage() {
      alert("आपका Message तैयार है! धन्यवाद 😊");
    }

  </script>

</body>
</html>